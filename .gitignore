.env
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.tmp
*.temp
*.bak
*.swp
~$*

# local data cache
data/raw/**/*.parquet
data/processed/**/*.parquet
data/signals/**/*.parquet
data/output/**/*.parquet
data/output/**/*.csv
data/output/**/*.json
data/reports/**/*.html
data/reports/**/*.png
data/reports/**/*.md

# quarantined pre-backfill data (forensic only, see data/quarantine_existing_v1/README.md)
data/quarantine_existing_v1/**/*.parquet

# quarantined notebook 14/15/16 chain artifacts (forensic only, see
# data/quarantine_notebook_chain_v1/README.md). READMEs stay tracked.
data/quarantine_notebook_chain_v1/**/*.parquet

# quarantined orphan feature files (forensic only, see
# data/quarantine_orphan_features_v1/README.md)
data/quarantine_orphan_features_v1/**/*.parquet

# notebooks outputs -- the sanctioned write target for notebooks, which may not
# write into pipeline-owned dirs (src/data/production_guard.py). Derived data,
# never committed. .csv added when notebook 12's report export was redirected
# here (AUDIT_NOTEBOOKS_REPORT.md OPEN_AUTO #3).
notebooks/outputs/**/*.parquet
notebooks/outputs/**/*.csv
*.log

# operational logs dir (daily_run.log, launchd_std*.log, check_notebooks
# JSON runlog) -- *.log alone missed non-.log files dropped here, leaving
# logs/ untracked-but-visible in git status; ignore the whole dir instead.
logs/

# system-font copy for scratch/render_handbook_pdf.py, recreated on demand
scratch/fonts/

# stray empty R history file, unrelated to this project
docs/.Rhistory
