*.swp
~$*

# local data cache
data/raw/**/*.parquet
data/processed/**/*.parquet
data/signals/**/*.parquet
data/output/**/*.parquet
data/output/**/*.csv
data/output/**/*.json
data/reports/**/*.html
data/reports/**/*.png
data/reports/**/*.md

# quarantined pre-backfill data (forensic only, see data/quarantine_existing_v1/README.md)
data/quarantine_existing_v1/**/*.parquet

# notebooks outputs if needed
notebooks/outputs/**/*.parquet
*.log

# operational logs dir (daily_run.log, launchd_std*.log, check_notebooks
# JSON runlog) -- *.log alone missed non-.log files dropped here, leaving
# logs/ untracked-but-visible in git status; ignore the whole dir instead.
logs/

# system-font copy for scratch/render_handbook_pdf.py, recreated on demand
scratch/fonts/

# stray empty R history file, unrelated to this project
docs/.Rhistory
